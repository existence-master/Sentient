{
  "name": "sentient-desktop",
  "productName": "Sentient",
  "version": "3.0.0-beta.1",
  "description": "Sentient - your local-first personal assistant",
  "author": "Existence",
  "private": true,
  "main": "./out/main/index.js",
  "homepage": "https://existence.technology",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package:engine": "node scripts/build-engine.mjs",
    "package:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "package:mac": "npm run build && electron-builder --mac --config electron-builder.yml",
    "package:linux": "npm run build && electron-builder --linux --config electron-builder.yml",
    "package": "npm run package:engine && npm run build && electron-builder --config electron-builder.yml",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test tests/*.test.ts"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tabler/icons-react": "3.50.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.105.0",
    "@types/node": "24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "electron": "44.10.0",
    "electron-builder": "26.18.0",
    "electron-vite": "5.0.0",
    "highlight.js": "11.12.0",
    "motion": "13.5.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-force-graph-2d": "^1.29.2",
    "react-markdown": "10.1.0",
    "react-router": "7.18.5",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "simple-icons": "16.36.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "zustand": "5.0.16"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
